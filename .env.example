# Copie para .env e preencha com os dados do projeto Firebase
# (Console do Firebase → Configurações do projeto → Seus apps → Configuração do SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Login com Google (opcional). Cliente OAuth do tipo "App para computador" no
# Google Cloud do projeto qfinancas-fc5bc. Veja docs/PLANO.md, Fase 1.
MAIN_VITE_GOOGLE_CLIENT_ID=
MAIN_VITE_GOOGLE_CLIENT_SECRET=
